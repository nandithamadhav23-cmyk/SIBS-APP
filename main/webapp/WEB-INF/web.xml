	<!--  ── Persistent Product Image Directory ─────────────────────────────  -->
	<!-- 
	        Images stored here survive redeployments and WAR rebuilds.
	        Create this directory once:  mkdir -p /opt/sibs-store/product-images
	        Then set ownership to tomcat user:  chown -R tomcat:tomcat /opt/sibs-store/
	     -->
