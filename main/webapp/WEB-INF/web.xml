	<location>/error404.jsp</location>
	</error-page>
	<error-page>
	<error-code>405</error-code>
	<location>/error404.jsp</location>
	</error-page>
	<error-page>
	<error-code>500</error-code>
	<location>/error500.jsp</location>
	</error-page>
	<error-page>
	<error-code>503</error-code>
	<location>/error500.jsp</location>
	</error-page>
	<error-page>
	<exception-type>java.lang.Exception</exception-type>
	<location>/error500.jsp</location>
	</error-page>
	<context-param>
	<param-name>anthropic.api_key</param-name>
	<param-value>${ANTHROPIC_API_KEY}</param-value>
	</context-param>
	<!--  ── ProductImageServlet — persistent image serving ───────────────────  -->
	<servlet>
	<servlet-name>ProductImageServlet</servlet-name>
	<servlet-class>com.servlet.ProductImageServlet</servlet-class>
	<load-on-startup>1</load-on-startup>
	</servlet>
	<servlet-mapping>
	<servlet-name>ProductImageServlet</servlet-name>
	<url-pattern>/product-image/*</url-pattern>
	</servlet-mapping>
