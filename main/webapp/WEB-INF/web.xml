	<!--  ── Delivery Agent Registration Servlet ─────────────────────────────  -->
	<servlet>
	<servlet-name>DeliveryRegisterServlet</servlet-name>
	<servlet-class>com.servlet.DeliveryRegisterServlet</servlet-class>
	<init-param>
	<param-name>uploadRootDir</param-name>
	<param-value>C:/delivery_uploads/KYC_docs</param-value>
	</init-param>
	</servlet>
	<servlet-mapping>
	<servlet-name>DeliveryRegisterServlet</servlet-name>
	<url-pattern>/DeliveryRegisterServlet</url-pattern>
	</servlet-mapping>
	<!--  ══════════════════════════════════════════════════════════════════════
	     ADD THESE BLOCKS TO YOUR web.xml  (inside the <web-app> root element)
	     ══════════════════════════════════════════════════════════════════════
	
	     AdminDeliveryReviewServlet handles four URL patterns.
	     The servlet has NO @WebServlet annotation (comment in the class explains why).
	     All mappings must be declared here.
	     ══════════════════════════════════════════════════════════════════════  -->
	<servlet>
	<servlet-name>AdminDeliveryReviewServlet</servlet-name>
	<servlet-class>com.servlet.AdminDeliveryReviewServlet</servlet-class>
	<!--  Must match the path used by DeliveryRegisterServlet so both servlets
	         read/write files from the same root directory.  -->
	<init-param>
	<param-name>uploadRootDir</param-name>
	<param-value>C:/delivery_uploads/KYC_docs</param-value>
	</init-param>
	<load-on-startup>2</load-on-startup>
	</servlet>
	<servlet>
	<servlet-name>LeaveServlet</servlet-name>
	<servlet-class>com.servlet.LeaveServlet</servlet-class>
	<init-param>
	<param-name>uploadRootDirLeave</param-name>
	<param-value>C:/staff_uploads/leave</param-value>
	<!--  ← Windows path  -->
	</init-param>
	<load-on-startup>2</load-on-startup>
	</servlet>
	<servlet-mapping>
	<servlet-name>LeaveServlet</servlet-name>
	<url-pattern>/LeaveServlet</url-pattern>
	</servlet-mapping>
	<!--  ── 2. LeaveDocServlet — securely streams docs to admin browser ───  -->
	<!-- 
	  This servlet MUST use the EXACT SAME uploadRootDirLeave value as
	  LeaveServlet above. If they differ, admins will get 404s when
	  trying to view documents.
	 -->
	<servlet>
	<servlet-name>LeaveDocServlet</servlet-name>
	<servlet-class>com.servlet.LeaveDocServlet</servlet-class>
	<init-param>
	<param-name>uploadRootDirLeave</param-name>
	<param-value>C:/staff_uploads/leave</param-value>
	<!--  ← must match above  -->
	</init-param>
	<load-on-startup>3</load-on-startup>
	</servlet>
	<servlet-mapping>
	<servlet-name>LeaveDocServlet</servlet-name>
	<url-pattern>/LeaveDocServlet</url-pattern>
	</servlet-mapping>
	<!--  1. POST: approve / reject a KYC application  -->
	<servlet-mapping>
	<servlet-name>AdminDeliveryReviewServlet</servlet-name>
	<url-pattern>/AdminDeliveryReviewServlet</url-pattern>
	</servlet-mapping>
	<!--  2. GET: list fragment (loaded AJAX into dashboard #mainContent)  -->
	<servlet-mapping>
	<servlet-name>AdminDeliveryReviewServlet</servlet-name>
	<url-pattern>/DeliveryAgentReview</url-pattern>
	</servlet-mapping>
	<!--  3. GET: detail fragment  -->
	<servlet-mapping>
	<servlet-name>AdminDeliveryReviewServlet</servlet-name>
	<url-pattern>/DeliveryAgentDetail</url-pattern>
	</servlet-mapping>
	<!--  4. GET: secure document/image serving from uploadRootDir  -->
	<servlet-mapping>
	<servlet-name>AdminDeliveryReviewServlet</servlet-name>
	<url-pattern>/AdminDocServlet</url-pattern>
	</servlet-mapping>
